# ==============================================================================
# SAP HANA Cloud In-Memory Database Configuration
# Read strictly by serverless functions & backend services via process.env
# ==============================================================================

# Your SAP HANA Cloud endpoint (e.g., xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.hana.trial-xx.hanacloud.ondemand.com)
HANA_HOST=

# SQL Port (default is 443 for SAP HANA Cloud)
HANA_PORT=443

# Database User (default is DBADMIN)
HANA_USER=DBADMIN

# Database Password set during SAP BTP instance provisioning
HANA_PASSWORD=

# Target database schema name
HANA_SCHEMA=RETURNPATH

# Enforce TLS encryption (true for SAP HANA Cloud)
HANA_USE_TLS=true

# ==============================================================================
# AI Features Configuration
# ==============================================================================

# Google Gemini API Key for AI Career Companion & Search Grounding
GEMINI_API_KEY=
